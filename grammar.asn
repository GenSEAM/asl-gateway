    (:sym :name "run-tests" :kind :fn :tokens 2)
    (:sym :name "make-lmk-profile" :kind :fn :tokens 3
          :rationale "Constructs an LmkProfile record")
    (:sym :name "mask-api-key" :kind :fn :tokens 3
          :rationale "Securely masks secret key preventing leakage in UI and telemetry logs")
