    (:sym :name "test-extract-tool-name" :kind :fn :tokens 4
          :rationale "Verifies tool name extraction")
    (:sym :name "test-format-tool-call-frame" :kind :fn :tokens 4
          :rationale "Verifies tool call frame formatting")
    (:sym :name "test-demux-raw-asn-turn" :kind :fn :tokens 4
          :rationale "Verifies demuxing raw turn into UI and tool frames")
    (:sym :name "test-extract-think-blocks" :kind :fn :tokens 4
          :rationale "Verifies think block extraction")
    (:sym :name "test-detect-esh-violation" :kind :fn :tokens 4
