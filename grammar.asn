          :rationale "Returns canonical ASN wire protocol negotiation headers")
    (:sym :name "is-tool-call?" :kind :fn :tokens 3
          :rationale "Determines if S-expression is an imperative tool call rather than declarative data")
    (:sym :name "is-declarative-asn?" :kind :fn :tokens 3
          :rationale "Determines if S-expression is declarative AST or data structure to preserve in UI stream")
    (:sym :name "extract-tool-name" :kind :fn :tokens 3
          :rationale "Extracts tool name from imperative tool call S-expression")
    (:sym :name "format-tool-call-frame" :kind :fn :tokens 4
          :rationale "Formats tool call into standard compact ASN S-expression")
    (:sym :name "demux-raw-asn-turn" :kind :fn :tokens 4
          :rationale "Demuxes turn into UI text and extracted tool call frames")
    (:sym :name "extract-think-blocks" :kind :fn :tokens 3
          :rationale "Separates think block from remaining conversational stream")
    (:sym :name "detect-esh-violation" :kind :fn :tokens 3
          :rationale "Detects verbal execution simulation claims without verified execution proof")
    (:sym :name "inspect-completion-turn" :kind :fn :tokens 3
          :rationale "Executes full L7 cognitive gateway inspection on completion turn")

    (:sym :name "test-ui-override-precedence" :kind :fn :tokens 4
          :rationale "Verifies dynamic UI override takes highest precedence")
